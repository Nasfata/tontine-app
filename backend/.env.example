# Adresse locale du serveur Express.
PORT=3000

# Paramètres de connexion MySQL utilisés par le backend.
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=tontine_db

# URL utilisée par Prisma ; encodez les caractères spéciaux du mot de passe.
DATABASE_URL="mysql://votre_utilisateur_mysql:votre_mot_de_passe_mysql@localhost:3306/tontine_db"

# Clé secrète longue et privée pour les jetons JWT.
JWT_SECRET=remplacer_par_une_cle_longue_et_aleatoire
